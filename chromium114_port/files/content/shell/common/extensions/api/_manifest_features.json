// R Chromium on 114: the "action" manifest key. Its handler is core, but in
// 114 the feature that lets a manifest use the key is //chrome's
// (chrome/common/extensions/api/_manifest_features.json), and without it the
// action API, which depends on manifest:action, is never exposed.
{
  "action": {
    "channel": "stable",
    "extension_types": ["extension"],
    "min_manifest_version": 3
  }
}
