+#if KDEBUG
+// Where each mutex was last acquired, in a small table hashed by the lock's
+// address: when a thread asks again for a lock it already holds, this says
+// where it took it the first time. Collisions only lose older entries.
+struct mutex_acquire_site {
+	mutex*		lock;
+	thread_id	thread;
+	addr_t		pc[6];
+};
+static const int32 kMutexAcquireSites = 2048;
+static mutex_acquire_site sMutexAcquireSites[kMutexAcquireSites];
+
+
+static inline mutex_acquire_site*
+mutex_acquire_site_for(mutex* lock)
+{
+	return &sMutexAcquireSites[((addr_t)lock >> 3) % kMutexAcquireSites];
+}
+
+
+static void
+record_mutex_acquire(mutex* lock, thread_id thread)
+{
+	mutex_acquire_site* site = mutex_acquire_site_for(lock);
+	addr_t pc[6];
+	memset(pc, 0, sizeof(pc));
+	arch_get_stack_trace(pc, 6, 0, 1, STACK_TRACE_KERNEL);
+	site->lock = lock;
+	site->thread = thread;
+	memcpy(site->pc, pc, sizeof(pc));
+}
+
+
+/*!	The calling thread asks for a mutex it already holds. So far that has
+	been a lock an earlier call on the same thread never released: the
+	thread really holds it, and nobody else will get it until this thread
+	lets go. A panic takes the machine down for that (seen from munmap()
+	under Chromium 114 on 32-bit x86); treating the request as granted lets
+	the caller's own unlock release it. Logged with where the lock was taken,
+	so that the leak can be found.
+*/
+static void
+report_mutex_double_lock(mutex* lock)
+{
+	thread_id thread = thread_get_current_thread_id();
+	dprintf("_mutex_lock(): thread %" B_PRId32 " asks again for mutex %p "
+		"(\"%s\") it already holds; going on\n", thread, lock,
+		lock->name != NULL ? lock->name : "");
+
+	mutex_acquire_site* site = mutex_acquire_site_for(lock);
+	if (site->lock == lock) {
+		dprintf("  first taken by thread %" B_PRId32 " at", site->thread);
+		for (int32 i = 0; i < 6 && site->pc[i] != 0; i++)
+			dprintf(" %#" B_PRIxADDR, site->pc[i]);
+		dprintf("\n");
+	}
+
+	addr_t pc[8];
+	memset(pc, 0, sizeof(pc));
+	int32 count = arch_get_stack_trace(pc, 8, 0, 1, STACK_TRACE_KERNEL);
+	dprintf("  asked again at");
+	for (int32 i = 0; i < count; i++)
+		dprintf(" %#" B_PRIxADDR, pc[i]);
+	dprintf("\n");
+}
+#endif
+
